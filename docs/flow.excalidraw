      "seed": 844818071,
      "version": 953,
      "versionNonce": 175602873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1752486155876,
      "link": null,
      "locked": false,
      "text": "Step 1: Create a Gemini Gems and include the documents relevant such as mutual success plan, \nnotes, success criterias and planning. \n\nStep 2: Use Gemini to create a good prompt to be used to generate the\n Product Requirements Document (PRD). \n\nStep 3: Use the prompt on Gemini to create your PRD to be used by Cursor.\n\nStep 4: USe the PDR in cursor to generate the POC (proof of concept) code.\n\nStep 5: Interact with proposed POC code in cursor. Verify and test.\n",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1: Create a Gemini Gems and include the documents relevant such as mutual success plan, \nnotes, success criterias and planning. \n\nStep 2: Use Gemini to create a good prompt to be used to generate the\n Product Requirements Document (PRD). \n\nStep 3: Use the prompt on Gemini to create your PRD to be used by Cursor.\n\nStep 4: USe the PDR in cursor to generate the POC (proof of concept) code.\n\nStep 5: Interact with proposed POC code in cursor. Verify and test.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
