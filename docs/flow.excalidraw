    {
      "id": "OMlvIhKcFYN0Pa4244iL4",
      "type": "text",
      "x": 477.6531205563065,
      "y": 89.28457028095494,
      "width": 1432.19970703125,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
